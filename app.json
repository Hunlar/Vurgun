
{
  "name": "KVP GAME",
  "description": "Telegram Kurtlar Vadisi temali gizli roller oyunu",
  "repository": "https://github.com/Hunlar/Vurgun",
  "keywords": [
    "telegram",
    "bot",
    "mafia",
    "game",
    "kurtlar-vadisi"
  ],
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "BotFather Telegram bot tokeni",
      "required": true
    },
    "OWNER_IDS": {
      "description": "Bot sahibi ve yonetici Telegram ID'leri. Birden fazla ID virgulle ayrilir.",
      "required": false
    },
    "REQUIRED_CHANNEL": {
      "description": "Zorunlu Telegram kanali",
      "value": "@sancakmain",
      "required": false
    },
    "CHANNEL_JOIN_URL": {
      "description": "Kanal katilim baglantisi",
      "value": "https://t.me/sancakmain",
      "required": false
    },
    "SUPPORT_URL": {
      "description": "Destek grubu veya destek kanali baglantisi",
      "required": false
    },
    "DB_PATH": {
      "description": "SQLite veritabani yolu",
      "value": "mafia.db",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1
    }
  }
}
